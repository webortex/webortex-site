# Front-end build configuration for the Mobility Media portal and screen player.
# Copy to `.env.local` (git-ignored). Every value is public: Vite inlines VITE_*
# variables into the browser bundle, so never put a secret here. Server secrets
# live in Firebase Secret Manager (see functions/.secret.local.example).

# --- Mobility Media Firebase project (separate from the legacy site's project)
# Firebase console -> Project settings -> Your apps -> Web app config.
VITE_MM_FIREBASE_PROJECT_ID=
VITE_MM_FIREBASE_API_KEY=
VITE_MM_FIREBASE_AUTH_DOMAIN=
VITE_MM_FIREBASE_APP_ID=

# --- API location
# The legacy site is served from Netlify, so in production the portal calls the
# function directly (CORS is allowed for the origins in MOBILITY_ALLOWED_ORIGINS):
#   https://asia-south1-<project-id>.cloudfunctions.net/api/mobility
# Leave unset when the site is served by Firebase Hosting (same-origin rewrite)
# or in local development (Vite proxies /api/mobility to the emulator).
VITE_API_BASE_URL=

# --- Local development
# Emulators are used automatically under `npm run dev`; set to "false" to point
# a dev server at a real project instead.
# VITE_USE_EMULATORS=true
# VITE_EMULATOR_HOST=127.0.0.1:5001
# VITE_EMULATOR_AUTH_HOST=127.0.0.1:9099
# VITE_MM_FUNCTIONS_REGION=asia-south1
