# Secrets for the local Functions emulator.
#
# Copy to `functions/.secret.local` (git-ignored) before `npm run emulators`.
# The emulator injects these as environment variables; deployed functions read
# the same names from Secret Manager (`npm run firebase:secrets -- NAME`).
#
# Any long random string works locally. Never reuse these values in production.

MOBILITY_AUDIT_SALT=local-audit-salt-change-me
MOBILITY_DEVICE_SECRET_PEPPER=local-device-pepper-change-me

# Razorpay test-mode keys (dashboard.razorpay.com, Test Mode). Leave blank to
# run without online top-ups: the "Add funds" button then reports that payments
# are not configured, and every webhook is rejected.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
