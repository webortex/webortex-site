    "@mui/icons-material": "^6.3.0",
    "@mui/material": "^6.3.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-table": "^9.2.4",
    "boxicons": "^2.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
