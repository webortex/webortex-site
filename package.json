{
  "name": "webortex-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm --prefix functions run typecheck",
    "preview": "vite preview",
    "emulators": "firebase emulators:start",
    "seed": "node functions/scripts/seed-emulator.mjs",
    "firebase:login": "firebase login",
    "firebase:use": "firebase use --add",
    "firebase:secrets": "firebase functions:secrets:set --project prod",
    "firebase:rules:deploy": "firebase deploy --project prod --only firestore:rules,storage",
    "firebase:indexes:deploy": "firebase deploy --project prod --only firestore:indexes",
    "firebase:functions:deploy": "firebase deploy --project prod --only functions",
    "firebase:deploy": "npm run firebase:rules:deploy && npm run firebase:indexes:deploy && npm run firebase:functions:deploy"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
